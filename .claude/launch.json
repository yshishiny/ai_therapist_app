{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend API (FastAPI)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "backend.app:app", "--reload", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "Web Portal (React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "Frontend Mock (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "Docker Stack (PostgreSQL + API)",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["up"],
      "port": 8001
    }
  ]
}
