# --------------------------------------------------------------------------------
# AI Therapist - Backend Environment Variables
# --------------------------------------------------------------------------------
# DO NOT commit real secrets here. This is a secure template for Railway / Local.
# Copy this file to .env and fill in your values.
# --------------------------------------------------------------------------------

# 1. Server Configuration
# Railway automatically injects PORT in production. Only needed locally.
PORT=8000

# 2. Database
# Standard PostgreSQL connection string
# Example: postgresql://username:password@localhost:5432/ai_therapist_db
DATABASE_URL=your_postgres_connection_string_here

# 3. AI / Integrations
# OpenAI Cloud: use your API key (sk-...)
# LM Studio (local): set OPENAI_BASE_URL=http://localhost:1234/v1 and OPENAI_API_KEY=lm-studio
OPENAI_API_KEY=your_openai_or_lmstudio_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 4. JWT Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED - no default. Must be at least 32 characters.
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# 5. CORS
# Comma-separated list of allowed origins for API access.
# Example: https://yourapp.com,https://admin.yourapp.com
# Use * for development only (insecure in production).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# 6. Firebase (used for push notifications and mobile auth)
# Path to your Firebase service account JSON file, OR set as an env var on Railway.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
# Alternatively on Railway, paste the entire JSON as a single-line string:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# 7. Environment
# Set to 'production' on Railway
ENVIRONMENT=development
