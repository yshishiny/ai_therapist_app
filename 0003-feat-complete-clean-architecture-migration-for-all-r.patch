+        result = await self.repository.update_appointment_status(
+            appointment_id=appointment_id,
+            org_id=org_id,
+            new_status=new_status,
+        )
+        if result is None:
+            raise HTTPException(
+                status_code=status.HTTP_404_NOT_FOUND,
+                detail="Appointment not found.",
+            )
+        return result
